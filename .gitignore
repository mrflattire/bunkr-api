# Ignore Python cache folders
__pycache__/
*.py[cod]
*$py.class
.ruff_cache/

# Distribution folders
dist/
build/

# Ignore virtual environments (if you use them)
venv/
.venv/
env/

# Ignore local configuration and secrets
.env
.pytest_cache/
.vscode/
.idea/

# Ignore all JSON files anywhere in the project
*.json
!coverage-badge.json

# Ignore the recon directory and everything inside it
#recon/
#recon_2/
#recon_3/
#scratch/

#local build artifacts
*.egg-info/

# Ignore the tests directory and everything inside it
#tests/

# Ignore the downloads directory and everything inside it
downloads/

# Test coverage reports
htmlcov/
.coverage
.coverage.*
coverage.xml
nosetests.xml


# SQLite WAL-mode sidecar files — regenerated automatically, never commit
*.db-wal
*.db-shm
 
# The database itself is local runtime state, not source. excluded since
# signed_cdn_url entries carry live auth tokens that shouldn't sit in git history
*.db